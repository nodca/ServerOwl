[Unit]
Description=Owl Master - Server Monitoring Master
Documentation=https://github.com/your-org/owl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=owl
Group=owl
ExecStart=/usr/local/bin/owl-master -config /etc/owl/master.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/owl /var/lib/owl
PrivateTmp=true

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 环境变量
Environment=OWL_LOG_LEVEL=info

[Install]
WantedBy=multi-user.target
