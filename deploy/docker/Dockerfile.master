# ServerOwl Master Dockerfile (前后端分离版)
# 多阶段构建：前端 + 后端

# ===== 前端构建阶段 =====
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

# 复制前端依赖文件
COPY web-react/package*.json ./
RUN npm ci --registry=https://registry.npmmirror.com

# 复制前端源码并构建
COPY web-react/ ./
RUN npm run build

# ===== 后端构建阶段 =====
FROM golang:1.21-alpine AS backend-builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o serverowl ./cmd/serverowl

# ===== 运行阶段 =====
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata wget

RUN mkdir -p /app/configs /app/web /app/skills /var/log/serverowl

WORKDIR /app

# 复制后端二进制
COPY --from=backend-builder /build/serverowl /app/serverowl

# 复制前端构建产物
COPY --from=frontend-builder /frontend/dist /app/web

# 复制默认配置
COPY deploy/docker/config/master.yaml /app/configs/config.yaml
COPY configs/tool_whitelist.yaml /app/configs/tool_whitelist.yaml

EXPOSE 19527 19528

ENTRYPOINT ["/app/serverowl"]
CMD ["-config", "/app/configs/config.yaml"]
